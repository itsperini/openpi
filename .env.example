# Credentials used by the Modal CLI to build and deploy the app.
# Generate or configure these with: modal token new
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Proxy token used by the Mac client to authenticate to the deployed WebSocket.
# Create it with: modal workspace proxy-tokens create
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# Replace this after deployment with the generated HTTPS URL, changing https:// to wss://.
OPENPI_MODAL_ENDPOINT=wss://YOUR-WORKSPACE--openpi-openpi-server.modal.run

# The Modal image clones this fork and checks out this exact commit.
# Update it to a pushed commit SHA whenever you want to deploy new server code.
OPENPI_REPOSITORY=https://github.com/itsperini/openpi.git
OPENPI_GIT_REF=15a9616a00943ada6c20a0f158e3adb39df2ccac

# OpenPI policy selection and Modal capacity.
OPENPI_SERVER_ARGS="--env=DROID"
OPENPI_GPU=L40S
OPENPI_MIN_CONTAINERS=0
