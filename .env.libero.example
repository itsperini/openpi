# Overlay loaded after .env by: ./scripts/deploy_modal.sh .env.libero
# Copy this file to .env.libero. It contains no credentials; those remain in .env.
OPENPI_APP_NAME=openpi-libero
OPENPI_SERVER_ARGS="--env=LIBERO"
# Keep the Franka policy loaded while actively testing. Change to 0 afterward.
OPENPI_MIN_CONTAINERS=1
