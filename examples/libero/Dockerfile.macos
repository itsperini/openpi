# Headless LIBERO / Franka runtime for Docker Desktop on Apple Silicon.
# Policy inference remains on Modal; this image runs MuJoCo and writes MP4s.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libglew2.2 \
    libglfw3 \
    libosmesa6 \
    && rm -rf /var/lib/apt/lists/*

COPY examples/libero/requirements.macos.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.9.0
RUN apt-get update && apt-get install -y --no-install-recommends \
    libc6-dev \
    gcc \
    linux-libc-dev \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt

COPY examples/libero/config.docker.yaml /tmp/libero-config/config.yaml

ENV LIBERO_CONFIG_PATH=/tmp/libero-config
ENV MUJOCO_GL=osmesa
ENV PYOPENGL_PLATFORM=osmesa
ENV PYTHONPATH=/app/packages/openpi-client/src:/app/third_party/libero

WORKDIR /app

CMD ["python", "examples/libero/main.py"]
